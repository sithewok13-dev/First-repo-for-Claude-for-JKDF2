# Telegram Arcade configuration. Copy to deploy/.env (Docker) or export the
# variables (bare Node). Never commit the filled-in file: it holds the bot token.
# Every value below shows its default unless marked REQUIRED.

# ---------------------------------------------------------------- Telegram
# REQUIRED (unless DEV_MODE=1): token from @BotFather. Never log or share it.
BOT_TOKEN=
# REQUIRED: the bot's username without "@"; checked against getMe at start.
BOT_USERNAME=
# Short name given to /newapp in BotFather (the link is t.me/<bot>/<short name>).
MINIAPP_SHORT_NAME=arcade
# polling (simplest, works behind NAT/tunnels) | webhook | off
UPDATES_MODE=polling
# webhook mode only: 16-256 characters from A-Z a-z 0-9 _ -
# (e.g. `openssl rand -hex 32`). Telegram needs https on 443, 80, 88 or 8443.
WEBHOOK_SECRET=
# Optional: comma-separated chat ids the bot may serve; it leaves any other group.
ALLOWED_CHAT_IDS=
# Launch data older than this is refused (seconds).
INITDATA_MAX_AGE_SEC=3600
# How long a sign-in lasts (seconds) and how long a membership answer is cached.
SESSION_TTL_SEC=43200
MEMBERSHIP_TTL_SEC=300
ANNOUNCE_MIN_INTERVAL_SEC=60

# Optional self-hosted Bot API server (uploads over 20 MB through Telegram).
# With deploy/docker-compose.yml profile "local-bot-api":
#   BOT_API_BASE=http://bot-api:8081  BOT_API_LOCAL=1  BOT_FILE_DIR=/var/lib/telegram-bot-api
# BOT_FILE_DIR may also be "<path on the Bot API server>=<same files here>".
BOT_API_BASE=https://api.telegram.org
BOT_API_LOCAL=0
BOT_FILE_DIR=
# Only for the local-bot-api profile (from https://my.telegram.org):
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------- Web
# REQUIRED: the public https origin of the Mini App, exactly as given to
# BotFather /newapp (Mini App methods only work from this origin).
PUBLIC_URL=https://arcade.example.com
# Host name Caddy requests a certificate for (deploy/Caddyfile).
PUBLIC_HOST=arcade.example.com
# Which entry point docker compose starts: public (Caddy on 80/443) or tunnel.
COMPOSE_PROFILES=public
# Cloudflare Tunnel token (profile "tunnel"); route the tunnel to http://arcade:8080.
CLOUDFLARE_TUNNEL_TOKEN=
HOST=0.0.0.0
PORT=8080
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For (compose does).
TRUST_PROXY=0

# ---------------------------------------------------------------- Storage
DATA_DIR=./data
# Per upload, after unpacking, archive entry limit and zip-bomb ratio limit.
MAX_UPLOAD_BYTES=67108864
MAX_EXTRACTED_BYTES=268435456
MAX_ARCHIVE_ENTRIES=512
MAX_COMPRESSION_RATIO=200
# Storage quota per group and for the whole server.
GROUP_QUOTA_BYTES=2147483648
GLOBAL_STORAGE_LIMIT_BYTES=42949672960
VALIDATION_TIMEOUT_MS=60000
MAX_CONCURRENT_VALIDATIONS=1
# Removed games stay restorable this many days before their files are deleted.
REMOVED_GAME_RETENTION_DAYS=7
# Backups kept by scripts/backup.ts (and the compose "backup" service).
BACKUP_KEEP=7

# ---------------------------------------------------------------- Rooms
# Concurrent running games (one per group) and viewers per room. Each running
# game uses about one CPU core at most (see docs/OPERATIONS.md, capacity).
MAX_ACTIVE_ROOMS=3
MAX_VIEWERS_PER_ROOM=16
# An empty room is checkpointed and paused, then released after this long.
ROOM_IDLE_RELEASE_SEC=300
CHECKPOINT_INTERVAL_SEC=30
WORKER_HEAP_MB=192
REPLAY_LOG_SECONDS=120
HASH_EVERY_FRAMES=120

# Default room rules (each group's host can change them in the arcade).
SEAT_OFFER_SECONDS=15
DISCONNECT_GRACE_SECONDS=30
HOST_GRACE_SECONDS=60
VOTE_SECONDS=60
CHAT_HISTORY=200
CHAT_RETENTION_DAYS=14

# ---------------------------------------------------------------- Logging / dev
# error | warn | info | debug (tokens, launch data and ROM contents are never logged)
LOG_LEVEL=info
# DEV_MODE=1 allows running without Telegram: a loopback-only dev sign-in,
# DEV_GROUP="Name" creates a test group, DEV_MEMBERS="1,2:administrator"
# lists who counts as a member. Never enable on a public server.
DEV_MODE=0
DEV_GROUP=
DEV_MEMBERS=

index c3335b7..cc420cb 100644
--- a/src/burn/drv/capcom/qs_c.cpp
+++ b/src/burn/drv/capcom/qs_c.cpp
@@ -778,6 +778,14 @@ INT32 QscScan(INT32 nAction)
 	ba.szName	= szName;
 	BurnAcb(&ba);
 
+	if (nAction & ACB_DRIVER_DATA) {
+		// [telegram-arcade] the chip-clock accumulator decides when the chip
+		// steps (and its ready flag, read by the Z80); the interpolation
+		// history is carried between frames.

diff --git a/src/burn/snd/burn_ym2151.cpp b/src/burn/snd/burn_ym2151.cpp
index 1b5c22a..a8812f7 100644
--- a/src/burn/snd/burn_ym2151.cpp
+++ b/src/burn/snd/burn_ym2151.cpp
@@ -378,6 +378,17 @@ void BurnYM2151Scan(INT32 nAction, INT32 *pnMin)
 
 	if (YM2151BurnTimer)
 		BurnTimerScan(nAction, pnMin);
+
+	// [telegram-arcade] Resampler state carried from one frame to the next. Without it a
+	// state loaded into a fresh instance renders a different number of chip
+	// samples per frame and drifts from the instance that saved it.
+	SCAN_VAR(nYM2151Position);
+	SCAN_VAR(nFractionalPosition);
+	if (pBuffer) {
+		for (INT32 b = 0; b < 4; b++) {
+			ScanVar(pBuffer + b * 4096, 64 * sizeof(INT16), (char*)"YM2151 carry");
+		}
+	}
 }
 

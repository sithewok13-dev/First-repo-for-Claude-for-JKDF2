<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>OpenJKDF2</string>
	<key>CFBundleDisplayName</key>
	<string>OpenJKDF2</string>
	<key>CFBundleExecutable</key>
	<string>@BIN_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@IOS_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@</string>
	<key>CFBundleVersion</key>
	<string>@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon.png</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>@IOS_PLATFORM_NAME@</string>
	</array>
	<key>MinimumOSVersion</key>
	<string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<!-- Metal-only: ANGLE's backend here is Metal, there is no GL fallback. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<!-- Without a UILaunchScreen key, iOS runs the app in a letterboxed
	     compatibility mode at a legacy resolution, so the CAMetalLayer ANGLE
	     draws into would not be the size of the screen. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- Opt in to real pointer events. Without this, UIKit only delivers
	     synthesized touches and a physically attached mouse/trackpad (a
	     Simulator host trackpad, or a paired mouse on iPadOS) cannot drive the
	     mouse-based JK menus; iOS also logs a warning about it at launch. -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- The game assets live in Documents/ (see InstallHelper_GetLocalDataDir);
	     these two make that folder reachable from Finder file sharing and the
	     Files app, which is the only way to get a JKDF2 install onto an iPhone. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>SDL_FILESYSTEM_BASE_DIR_TYPE</key>
	<string>bundle</string>
	<!-- Gyro aiming (iosTouch.m) reads CoreMotion's device motion, which
	     needs no permission today; this is the reason iOS would show if it
	     ever starts asking for one. -->
	<key>NSMotionUsageDescription</key>
	<string>Turning the device aims, while gyro aiming is on (hold MENU to set it).</string>
	<!-- The CAMERA button (iosPhotos.m) adds its photos to the library, and
	     asks for add-only access when CAMERA is switched on in MENU's tray.
	     Without this key iOS ends the app at that question. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>The CAMERA button saves its photos to your library.</string>
	<!-- Multiplayer (src/Platform/Networking/ENet) talks to the other players'
	     devices on the Wi-Fi network: iOS asks once, the first time the game
	     hosts or joins, and without this key it refuses. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Multiplayer finds and connects to the other players' devices on your Wi-Fi network.</string>
	<!-- Join Game lists the games hosted on the same Wi-Fi (Bonjour, stdComm_ENetDiscover.c): iOS lets
	     an app look for, and offer, only the Bonjour services named here. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_openjkdf2._udp</string>
	</array>
</dict>
</plist>
